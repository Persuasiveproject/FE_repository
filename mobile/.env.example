# 공개 설정입니다. 비밀번호/토큰/서버 비밀키는 넣지 마세요.
# Mock 홈에는 필요 없습니다. 실제 API 서버의 origin만 입력합니다(/v1 제외).
# Android 에뮬레이터는 10.0.2.2, 실기기는 PC의 LAN IP를 사용합니다.
EXPO_PUBLIC_API_BASE_URL=https://dev-api.yeongup.shop
# mock: 메모리 데모. api: Basic 시연 인증과 실제 서버 조회·쓰기.
EXPO_PUBLIC_DATA_SOURCE=mock
# BE #49 배포와 인증·계약 검증 후에만 true로 변경합니다. 기본값은 false.
EXPO_PUBLIC_OPINION_REACTIONS_ENABLED=false
